# Secrets — plaintext .env never committed (SOPS-encrypted env.sops.env IS committed)
.env
.env.*
!.env.example
*.creds
*.token
*.pem
*.key
secrets/*.env
!secrets/*.sops.env

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# IDE / OS
.vscode/
.idea/
.claude/
.DS_Store
Thumbs.db

# Logs / temp
*.log
*.local
*.bak
.tmp_*/

# Backup artifacts
backup-*/
restore/

# ComEd bill ingest runtime — bills contain personal info, never commit
deploy/energy-stack/inbox/

# Local pipeline exports (per-run, large, gitignored)
analysis/exports/

# Firecrawl tool cache (reference PDFs etc; local-only)
.firecrawl/

# Decision-trace commissioning reports (transient artifacts)
docs/test-reports/*.md
!docs/test-reports/README.md
.codex/

# Cockpit dev artifacts (local-only; should never be committed)
/node_modules/
.vite/
.playwright-mcp/
reticule-*.png
reference-original.png

# Replay-validation runner output (per spec §11 #13 artifact policy):
# Intermediate runs live on GitHub Actions and are not committed.
# The canonical validation_results.json is committed only at the
# OSF-freeze commit. findings_draft.md is a runner template;
# findings.md (human-curated) is the canonical narrative.
docs/replay-validation/**/validation_results.json
docs/replay-validation/**/findings_draft.md

# Understand-Anything knowledge graph:
# Commit knowledge-graph.json + fingerprints.json + meta.json + config.json +
# .understandignore (teammates skip the pipeline, auto-update stays incremental).
# Exclude per-run scratch only.
.understand-anything/intermediate/
.understand-anything/tmp/
.understand-anything/diff-overlay.json
