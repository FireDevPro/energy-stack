# Copy to .env on Pi-lab and fill in. chmod 600. NEVER commit .env.
# Generate strong values with: openssl rand -base64 32

# ---- Postgres ----
POSTGRES_USER=n8n
POSTGRES_PASSWORD=changeme-strong-password
POSTGRES_DB=n8n

# ---- n8n network identity ----
# These appear in webhook URLs n8n shows in the UI and what external services hit.
# Use the Pi's LAN IP unless you front it with a reverse proxy + DNS name.
N8N_HOST=192.168.20.10
WEBHOOK_URL=http://192.168.20.10:5678/

# ---- n8n encryption key ----
# 32-byte random key. Encrypts stored credentials. LOSING THIS = all stored
# credentials become unrecoverable. Generate with: openssl rand -base64 32
# Backed up as part of the n8n_data Docker volume via pi-backup.sh.
N8N_ENCRYPTION_KEY=changeme-32-byte-base64-random
