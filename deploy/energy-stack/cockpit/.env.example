# Controller Cockpit live-mode credentials.
# Copy this file to .env.local (gitignored) and fill in real values.
# start-cockpit.ps1 sources .env.local on launch.

INFLUXDB_URL=http://192.168.20.10:8086
INFLUXDB_TOKEN=replace-with-token-from-pi-lab-.env
INFLUXDB_ORG=depaola-home
INFLUXDB_BUCKET=energy
LOKI_URL=http://192.168.20.10:3100

# Optional. Defaults to "hvac-scheduler" when unset.
# LOKI_CONTAINER=hvac-scheduler
