# Copy to .env on Pi-lab and fill in. chmod 600. NEVER commit .env.
# Generate tokens/passwords with: openssl rand -base64 32

# ---- InfluxDB initial setup (consumed on first container start only) ----
INFLUXDB_INIT_USERNAME=admin
INFLUXDB_INIT_PASSWORD=changeme-strong-password
INFLUXDB_INIT_ORG=depaola-home
INFLUXDB_INIT_BUCKET=energy
INFLUXDB_INIT_RETENTION=0s
INFLUXDB_INIT_ADMIN_TOKEN=changeme-generate-openssl-rand-base64-32

# ---- Grafana admin ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme-strong-password

# ---- Rainforest EAGLE-3 (Phase 3.3 poller) ----
EAGLE_IP=192.168.20.192
EAGLE_CLOUD_ID=changeme-from-eagle-device
EAGLE_INSTALL_CODE=changeme-from-eagle-device
EAGLE_METER_HW_ADDRESS=0x001350050037ac6b
EAGLE_POLL_INTERVAL=30

# ---- ComEd Hourly Pricing (Phase 3.2 poller) ----
COMED_POLL_INTERVAL=60

# ---- PJM Data Miner 2 (Non-Member API; 5CP forecaster + LMP context) ----
# Get a free Non-Member key at https://apiportal.pjm.com/. Schema and
# integration design: docs/PJM_DM2_INTEGRATION.md. Feed catalog with
# ComEd-specific filter constants: docs/PJM_DM2_FEEDS.md.
# Live wake loop ticks every 5 minutes (300s) so sub-hourly feeds like
# inst_load (every 5 min, both ComEd-zone + RTO-aggregate) fire on every
# tick and hourly feeds like hrl_load_metered fire on the :00 tick.
# Per-feed schedule lives in pjm_dm2_poller/app.py FEED_SCHEDULE.
# Total steady-state ~700-720 calls/day; well under the 6 calls/min ceiling.
PJM_DM2_API_KEY=changeme-from-pjm-api-portal
PJM_DM2_POLL_INTERVAL=300

# ---- Refoss EM16P (Phase 5 poller) ----
# Local LAN device, JSON-RPC over HTTP. Auth disabled (open on LAN per
# project threat model: local-only, single-user). IP must be reachable
# from Pi-lab (192.168.20.10) on the homelab VLAN.
REFOSS_IP=192.168.20.140
REFOSS_POLL_INTERVAL=30

# ---- NWS forecast poller (Phase 6) ----
NWS_LAT=41.6151
NWS_LON=-88.2018
NWS_USER_AGENT=energy-stack/1.0 (contact@local)
NWS_POLL_INTERVAL=1800

# ---- HVAC Scheduler (Phase 6) ----
# Control4 account creds for pyControl4 cloud auth (one-time, then local director token).
# Director IP and thermostat item ID determined empirically (see Open Brain).
# SCHEDULER_MODE controls write-gating (replaces the retired SCHEDULER_DRY_RUN
# env var per spec §3 + the SCED rebaseline plan):
#   shadow     -- never writes (logs decisions only). Safe default for
#                 pre-experiment-start operation.
#   experiment -- writes ONLY during Arm B periods inside the locked
#                 2026-06-01..2026-11-16 calendar. Outside the window =
#                 no writes (no implicit pre-experiment fallback).
#   production -- writes always; ignores A/B calendar. Used only for
#                 deliberate non-study operation. Excluded from analysis.
# The hvac-scheduler container refuses to start (sys.exit(2)) on missing or
# invalid SCHEDULER_MODE.
CONTROL4_EMAIL=changeme-c4-account-email
CONTROL4_PASSWORD=changeme-c4-account-password
CONTROL4_CONTROLLER_IP=192.168.1.30
CONTROL4_THERMOSTAT_ID=3231
SCHEDULER_MODE=shadow
SCHEDULER_DECISION_HOUR=21
# Comma-separated local hours at which to re-poll today's forecast and
# re-classify the day-type if it shifted since the 21:00 commitment. Catches
# forecast-bust days. Empty disables the revisit. Default 6,11 covers the
# morning forecast refresh and the late-morning update before noon transitions.
SCHEDULER_REVISIT_HOURS=6,11
SCHEDULER_TZ=America/Chicago

# ---- Thermostat poller (Phase 6+, May 2026) ----
# Continuous Control4 reads of VisionPRO state every THERMOSTAT_POLL_INTERVAL seconds.
# 600s (10 min) is the TCC rate-limit floor. OVERRIDE_GRACE_MIN suppresses
# spurious override flags right after a scheduler action.
THERMOSTAT_POLL_INTERVAL=600
OVERRIDE_GRACE_MIN=5

# ---- Haven IAQ API poller (Phase 7, May 2026) ----
# Auth via Auth0 refresh token — obtain once from a browser login session:
#   1. Log into my.haveniaq.com with DevTools Network tab open
#   2. Find the POST to haven-production.auth0.com/oauth/token
#   3. Copy refresh_token from the Response tab
# Token auto-refreshes every 24 h. Re-capture if refresh token expires (~90 days idle).
HAVEN_CLIENT_ID=JX2N4mY1vv3LLQmOVnID5hlCKqeT1BAp
HAVEN_REFRESH_TOKEN=changeme-capture-from-browser-login
HAVEN_DEVICE_ID=3645
HAVEN_OUTDOOR_ID=60585
HAVEN_POLL_INTERVAL=300
HAVEN_BACKFILL_DAYS=7
# HAVEN_TOKEN_FILE=/data/haven_token.json  # default; change only if remapping the volume

# ---- Ecowitt GW1200 push receiver (Phase 7+, May 2026) ----
# Listens for Ecowitt-protocol POSTs from the GW1200B v1.4.7 gateway.
#
# Two-stream design:
#   - WS90 (7-in-1 on pergola, S/E roof, sun-exposed) -> wind, solar, piezo
#     rain, UV, AND its onboard temp/RH on tempf/humidity. The WS90's temp
#     is captured as the SUN comparator -> ws90_temp_f / ws90_rh_pct /
#     ws90_dewpoint_f. The WH26 outdoor slot is intentionally left empty.
#   - WN31 (multi-channel sensor in UV shield on shaded N/E wall) ->
#     CANONICAL outdoor temp/RH. Set ECOWITT_SHADED_CHANNEL to the WN31's
#     dip-switch channel (1-8). Until that's set, outdoor_temp_f /
#     outdoor_rh_pct / outdoor_dewpoint_f will NOT be written -- preventing
#     downstream analysis from silently treating the sun reading as canonical.
#
# Gateway config (WSView -> Weather Services -> Customized):
#   Protocol: Ecowitt · Server: <pi-lab LAN IP> · Path: /data/report/ ·
#   Port: 8088 · Upload Interval: 60s
ECOWITT_LISTEN_PORT=8088
# Leave blank while the shaded WN31 is unpaired; set to its dip-switch
# channel (1-8) once paired and reporting.
ECOWITT_SHADED_CHANNEL=

# ---- Telegram notifier (Phase 6) ----
# Either reuse Life Engine bot or create a new one via @BotFather.
# Get chat ID via https://api.telegram.org/bot<TOKEN>/getUpdates after sending /start.
TELEGRAM_BOT_TOKEN=changeme-bot-token
TELEGRAM_CHAT_ID=changeme-chat-id
TELEGRAM_SUMMARY_HOUR=8
TELEGRAM_ALERT_INTERVAL_S=300
TELEGRAM_POLLER_SILENT_MIN=10
TELEGRAM_PRICE_SPIKE_C=20
TELEGRAM_ALERT_DEDUPE_MIN=30

# ---- ComfortNet HVAC pipeline (Mosquitto + Telegraf, profile=mqtt) ----
# Three identities for the broker. Passwords seed the password file via the
# mosquitto-init container; rotate by changing here and re-running
# `compose --profile mqtt up -d`. Generate strong values:
#   openssl rand -base64 32
# Live publisher: github.com/Promithius-DR/comfortnet · Historical design: docs/archive/COMFORTNET_PIPELINE.md
MOSQUITTO_PUBLISHER_PASSWORD=changeme-publisher-password
MOSQUITTO_TELEGRAF_PASSWORD=changeme-telegraf-password
MOSQUITTO_N8N_PASSWORD=changeme-n8n-password
