%% Top-level architecture diagram for README.md
%% Source of truth. Rendered to architecture.svg via:
%%   npx -y @mermaid-js/mermaid-cli -i docs/diagrams/architecture.mmd -o docs/diagrams/architecture.svg -t neutral -b transparent
%% Re-render after any edits and commit both files together.

flowchart LR
  classDef store fill:#e8eef7,stroke:#3b6aa0,color:#0b2540
  classDef input fill:#f5f5f5,stroke:#888,color:#222
  classDef output fill:#eef5ec,stroke:#3a7a3a,color:#143a14
  classDef hw fill:#fff7e0,stroke:#a07a14,color:#3a2a05

  subgraph IN["Inputs"]
    direction TB
    E["EAGLE-3<br/>billing meter"]:::input
    C["ComEd Hourly<br/>Pricing"]:::input
    P["PJM Data Miner 2<br/>LMP / load / 5CP"]:::input
    N["NWS forecast<br/>+ alerts"]:::input
    R["Refoss EM16P<br/>per-circuit"]:::input
    W["Ecowitt<br/>outdoor + indoor"]:::input
    T["CTK04AE state<br/>(10-min reads)"]:::input
  end

  DB[("InfluxDB 2.7<br/>energy +<br/>energy-longterm")]:::store

  subgraph OUT["Decision &amp; output"]
    direction TB
    H["hvac-scheduler<br/>Arm B controller<br/>+ safety supervisor"]:::output
    G["Grafana<br/>(dashboards)"]:::output
    L["Loki + Promtail<br/>(logs)"]:::output
    M["telegram-notifier"]:::output
  end

  TS["CTK04AE thermostat<br/>(Amana 2-stage AC<br/>+ modulating furnace)"]:::hw

  E --> DB
  C --> DB
  P --> DB
  N --> DB
  R --> DB
  W --> DB
  T --> DB
  DB --> H
  DB --> G
  DB --> M
  DB --> L
  H --> TS
